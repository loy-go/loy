package app

import (
	"context"
	"database/sql"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

{{if eq .HTTPFramework "fiber"}}
	"github.com/gofiber/fiber/v2"
	"github.com/gofiber/fiber/v2/middleware/adaptor"
{{else if eq .HTTPFramework "chi"}}
	"github.com/go-chi/chi/v5"
	"github.com/go-chi/chi/v5/middleware"
{{else if eq .HTTPFramework "gin"}}
	"github.com/gin-gonic/gin"
{{end}}

	"{{.ModulePath}}/internal/config"
	"{{.ModulePath}}/internal/platform/health"
	"{{.ModulePath}}/internal/platform/shutdown"
)

// State represents the runtime lifecycle state of the application.
type State string

const (
	StateCreated      State = "Created"
	StateInitializing State = "Initializing"
	StateReady        State = "Ready"
	StateRunning      State = "Running"
	StateStopping     State = "Stopping"
	StateStopped      State = "Stopped"
)

// App is the root composition application component.
type App struct {
	cfg         *config.Config
	log         *slog.Logger
	state       State
	mu          sync.RWMutex
	coordinator *shutdown.Coordinator
	healthReg   *health.Registry

{{if eq .HTTPFramework "fiber"}}
	router      *fiber.App
{{else if eq .HTTPFramework "chi"}}
	router      *chi.Mux
	server      *http.Server
{{else if eq .HTTPFramework "gin"}}
	router      *gin.Engine
	server      *http.Server
{{else}}
	mux         *http.ServeMux
	server      *http.Server
{{end}}
	db          *sql.DB
}

// New creates and initializes a new App instance.
func New(cfg *config.Config, log *slog.Logger) (*App, error) {
	app := &App{
		cfg:         cfg,
		log:         log,
		state:       StateCreated,
		coordinator: shutdown.NewCoordinator(),
		healthReg:   health.NewRegistry(),
	}

	if err := app.init(); err != nil {
		// Clean up any resources created before failure
		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
		defer cancel()
		_ = app.coordinator.Teardown(ctx)
		return nil, fmt.Errorf("initializing app: %w", err)
	}

	return app, nil
}

func (a *App) setState(s State) {
	a.mu.Lock()
	defer a.mu.Unlock()
	a.state = s
}

// State returns the current lifecycle state.
func (a *App) State() State {
	a.mu.RLock()
	defer a.mu.RUnlock()
	return a.state
}

func (a *App) init() error {
	a.setState(StateInitializing)

{{if eq .HTTPFramework "fiber"}}
	a.router = fiber.New(fiber.Config{
		DisableStartupMessage: true,
		ReadTimeout:           10 * time.Second,
		WriteTimeout:          15 * time.Second,
		IdleTimeout:           120 * time.Second,
		BodyLimit:             4 * 1024 * 1024,
	})

	// Register health probes
	a.router.Get("/health/live", adaptor.HTTPHandlerFunc(a.healthReg.LiveHandler()))
	a.router.Get("/health/ready", adaptor.HTTPHandlerFunc(a.healthReg.ReadyHandler()))
{{else if eq .HTTPFramework "chi"}}
	a.router = chi.NewRouter()
	a.router.Use(middleware.RequestID)
	a.router.Use(middleware.Recoverer)

	// Register health probes
	a.router.Get("/health/live", a.healthReg.LiveHandler())
	a.router.Get("/health/ready", a.healthReg.ReadyHandler())

	a.server = &http.Server{
		Addr:              fmt.Sprintf(":%d", a.cfg.Port),
		Handler:           a.router,
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       10 * time.Second,
		WriteTimeout:      15 * time.Second,
		IdleTimeout:       120 * time.Second,
	}
{{else if eq .HTTPFramework "gin"}}
	gin.SetMode(gin.ReleaseMode)
	a.router = gin.New()
	a.router.Use(gin.Recovery())

	// Register health probes
	a.router.GET("/health/live", gin.WrapH(a.healthReg.LiveHandler()))
	a.router.GET("/health/ready", gin.WrapH(a.healthReg.ReadyHandler()))

	a.server = &http.Server{
		Addr:              fmt.Sprintf(":%d", a.cfg.Port),
		Handler:           a.router,
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       10 * time.Second,
		WriteTimeout:      15 * time.Second,
		IdleTimeout:       120 * time.Second,
	}
{{else}}
	a.mux = http.NewServeMux()
	a.server = &http.Server{
		Addr:              fmt.Sprintf(":%d", a.cfg.Port),
		Handler:           a.mux,
		ReadHeaderTimeout: 5 * time.Second,
		ReadTimeout:       10 * time.Second,
		WriteTimeout:      15 * time.Second,
		IdleTimeout:       120 * time.Second,
	}

	// Register health probes
	a.mux.HandleFunc("/health/live", a.healthReg.LiveHandler())
	a.mux.HandleFunc("/health/ready", a.healthReg.ReadyHandler())
{{end}}

	// Wire application dependencies
	if err := a.wireDependencies(); err != nil {
		return fmt.Errorf("wiring dependencies: %w", err)
	}

	// Register transport shutdown hook
{{if eq .HTTPFramework "fiber"}}
	a.coordinator.Register(shutdown.PhaseTransport, func(ctx context.Context) error {
		return a.router.ShutdownWithContext(ctx)
	})
{{else}}
	a.coordinator.Register(shutdown.PhaseTransport, func(ctx context.Context) error {
		return a.server.Shutdown(ctx)
	})
{{end}}

	a.setState(StateReady)
	return nil
}

// Run starts the application and blocks until context cancellation or OS termination signal.
func (a *App) Run(ctx context.Context) error {
	a.setState(StateRunning)

	sigCtx, stopSignals := signal.NotifyContext(ctx, os.Interrupt, syscall.SIGTERM)
	defer stopSignals()

	serverErr := make(chan error, 1)

	go func() {
{{if eq .HTTPFramework "fiber"}}
		addr := fmt.Sprintf(":%d", a.cfg.Port)
		a.log.Info("http server listening", "addr", addr, "framework", "fiber")
		if err := a.router.Listen(addr); err != nil && !errors.Is(err, http.ErrServerClosed) {
			serverErr <- err
		}
{{else if eq .HTTPFramework "chi"}}
		a.log.Info("http server listening", "addr", a.server.Addr, "framework", "chi")
		if err := a.server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			serverErr <- err
		}
{{else if eq .HTTPFramework "gin"}}
		a.log.Info("http server listening", "addr", a.server.Addr, "framework", "gin")
		if err := a.server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			serverErr <- err
		}
{{else}}
		a.log.Info("http server listening", "addr", a.server.Addr, "framework", "net/http")
		if err := a.server.ListenAndServe(); err != nil && !errors.Is(err, http.ErrServerClosed) {
			serverErr <- err
		}
{{end}}
	}()

	shutdownTimeout := a.cfg.ShutdownTimeout
	if shutdownTimeout <= 0 {
		shutdownTimeout = 15 * time.Second
	}

	select {
	case <-sigCtx.Done():
		stopSignals()
		a.log.Info("shutdown signal received")
	case err := <-serverErr:
		shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
		defer cancel()
		_ = a.Stop(shutdownCtx)
		return fmt.Errorf("server error: %w", err)
	}

	shutdownCtx, cancel := context.WithTimeout(context.Background(), shutdownTimeout)
	defer cancel()

	return a.Stop(shutdownCtx)
}

// Stop executes graceful shutdown across all phases.
func (a *App) Stop(ctx context.Context) error {
	a.setState(StateStopping)
	a.log.Info("starting graceful shutdown")

	err := a.coordinator.Teardown(ctx)
	a.setState(StateStopped)
	if err != nil {
		a.log.Error("graceful shutdown completed with errors", "error", err)
		return err
	}

	a.log.Info("graceful shutdown completed successfully")
	return nil
}
