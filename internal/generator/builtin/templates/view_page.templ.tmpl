package {{ .PackageName }}

import (
	"{{ .ModulePath }}/views/layouts"
)

templ {{ .Pascal }}() {
	@layouts.Base("{{ .Title }}") {
		<div class="container mx-auto px-4 py-8">
			<h1 class="text-3xl font-bold mb-4">{{ .Title }}</h1>
			<p class="text-gray-600">Scaffolded with Loy fullstack engine.</p>
		</div>
	}
}
