image: golang:1.23-alpine

stages:
  - test
  - build

{{if or (and .WithDatabase (ne .DatabaseDialect "sqlite")) .WithCache}}services:
  {{if .WithDatabase}}{{if eq .DatabaseDialect "mysql"}}- mysql:8.0
  {{else if or (eq .DatabaseDialect "postgres") (eq .DatabaseDialect "")}}- postgres:16-alpine
  {{end}}{{end}}{{if .WithCache}}- valkey/valkey:7-alpine
  {{end}}
{{end}}{{if or .WithDatabase .WithCache}}variables:
  {{if .WithDatabase}}{{if eq .DatabaseDialect "mysql"}}MYSQL_ROOT_PASSWORD: "root"
  MYSQL_DATABASE: "{{.ProjectName}}_test"
  DATABASE_URL: "root:root@tcp(mysql:3306)/{{.ProjectName}}_test?parseTime=true"
  {{else if eq .DatabaseDialect "sqlite"}}DATABASE_URL: "file:memdb?mode=memory&cache=shared"
  {{else}}POSTGRES_USER: loy
  POSTGRES_PASSWORD: loy_secret
  POSTGRES_DB: {{.ProjectName}}_test
  DATABASE_URL: "postgres://loy:loy_secret@postgres:5432/{{.ProjectName}}_test?sslmode=disable"
  {{end}}{{end}}{{if .WithCache}}VALKEY_ADDR: "valkey:6379"
  {{end}}
{{end}}test:
  stage: test
  before_script:
    - apk add --no-cache git ca-certificates tzdata build-base
  script:
    - go mod verify
    - go vet ./...
    - go run github.com/loy-go/loy/cmd/loy@latest check
    - go test -v -race -cover ./...

build:
  stage: build
  before_script:
    - apk add --no-cache git ca-certificates tzdata
  script:
    - go build -v ./...
