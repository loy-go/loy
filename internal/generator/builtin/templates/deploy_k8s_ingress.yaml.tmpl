apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{.ProjectName}}
  labels:
    app: {{.ProjectName}}
  annotations:
    kubernetes.io/ingress.class: nginx
spec:
  rules:
    - host: {{.ProjectName}}.example.com
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{.ProjectName}}
                port:
                  number: 80
  tls:
    - hosts:
        - {{.ProjectName}}.example.com
      secretName: {{.ProjectName}}-tls
