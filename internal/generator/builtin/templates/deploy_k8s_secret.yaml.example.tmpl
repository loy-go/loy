# Example production secret template.
# DO NOT COMMIT PRODUCTION CREDENTIALS TO SOURCE CONTROL.
# Apply to cluster with: kubectl apply -f deploy/k8s/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: {{.ProjectName}}-secret
  labels:
    app: {{.ProjectName}}
type: Opaque
stringData:
  {{if .WithDatabase}}database-url: "postgres://user:password@postgres-host:5432/dbname?sslmode=require"
  {{end}}{{if .WithCache}}valkey-password: "change-me-secret-password"
  {{end}}
